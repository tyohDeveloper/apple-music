{
  "name": "apple-music",
  "version": "0.2.0.0",
  "description": "Apple Music library manager: first-class albums, recordings and performers, with curated metadata kept beyond Apple Music.",
  "license": "MIT",
  "author": "David Hoyt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/run-dev.ts",
    "start": "node dist/server/src/server/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "check:standards": "tsx scripts/check-standards.ts",
    "check:dead-code": "knip",
    "check:bindings": "tsx scripts/check-bindings.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "bundle": "vite build && tsc -p tsconfig.server.json",
    "verify:build": "tsx scripts/verify-build.ts",
    "build": "npm run typecheck && npm run check:standards && npm run check:dead-code && npm run check:migrations && npm run test:unit && npm run test:integration && npm run bundle && npm run check:bindings && npm run verify:build",
    "test:e2e": "playwright test",
    "db:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-database.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate-database.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "write:export-schema": "tsx scripts/write-export-schema.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/type-provider-typebox": "6.3.0",
    "argon2": "0.45.1",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "preact": "11.0.1",
    "typebox": "1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "knip": "6.42.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "argon2": false,
    "esbuild": false
  }
}
