# Copy to .env (development) or .env.test (tests). Never commit real values.

# Public origin of the application, as the browser sees it.
BETTER_AUTH_URL=http://localhost:5173
# Random secret of at least 32 characters for signing sessions, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Extra origins allowed to call the API (comma-separated), e.g. the Vite dev server.
TRUSTED_ORIGINS=

# HTTP listener.
HOST=127.0.0.1
PORT=5174

# Database roles (docs/ARCHITECTURE.md). Usernames are fixed: apple_music_app and
# apple_music_auth are created by `npm run db:bootstrap` with the passwords given here.
DATABASE_URL=postgres://apple_music_app:CHANGE_ME@127.0.0.1:5432/apple_music_dev
DATABASE_AUTH_URL=postgres://apple_music_auth:CHANGE_ME@127.0.0.1:5432/apple_music_dev
DATABASE_ADMIN_URL=postgres://apple_music_owner:CHANGE_ME@127.0.0.1:5432/apple_music_dev
# Optional: connections per pool (default 10) and statement timeout in ms (default 15000).
DATABASE_POOL_MAX=
DATABASE_STATEMENT_TIMEOUT_MS=

# 32 random bytes, base64-encoded (`openssl rand -base64 32`), for encrypting stored Music
# User Tokens. Apple Music features need it and the three Apple settings below; without them
# they report "not configured". Changing it makes stored tokens unreadable: each library is
# then connected again (docs/design/apple-music-import.md, "Slice G as built").
TOKEN_ENCRYPTION_KEY=

# Apple Developer credentials (optional until Apple Music features are used).
APPLE_TEAM_ID=
APPLE_MUSICKIT_KEY_ID=
# The MusicKit private key (.p8 contents) with newlines written as \n.
APPLE_MUSICKIT_PRIVATE_KEY=
# Override only for tests against the Apple Music fake.
APPLE_MUSIC_API_BASE_URL=https://api.music.apple.com

# Owner account created by `npm run seed`.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
