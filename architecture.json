{
  "schemaVersion": 1,
  "description": "Machine-readable form of docs/ARCHITECTURE.md, read by npm run check:standards, which also verifies that the two agree.",
  "roles": [
    {"role": "VIEW", "paths": ["src/browser/views/**/*.tsx", "src/browser/main.tsx", "src/browser/index.html", "src/browser/styles/**/*.css"], "maxFileLines": 250},
    {"role": "CONTROLLER", "paths": ["src/server/**", "src/browser/controllers/**"], "maxFileLines": 150},
    {"role": "STATE", "paths": ["src/browser/state/**"], "maxFileLines": 150},
    {"role": "PURE-CORE", "paths": ["src/credits/**", "src/names/**", "src/editions/**"], "maxFileLines": 100},
    {"role": "PURE", "paths": ["src/library-sync/**", "src/partial-dates/**", "src/localization/**", "src/taxonomies/**", "src/routing/**", "src/metrics/**", "src/contracts/**"], "maxFileLines": 150},
    {"role": "DATA", "paths": ["data/**"]},
    {"role": "PLATFORM-PURE", "paths": [], "allowlist": "platform-pure-allowlist.json", "maxFileLines": 100},
    {"role": "PLATFORM-AMBIENT", "paths": ["src/platform/**"], "maxFileLines": 150},
    {"role": "MODEL", "paths": ["src/db/**", "drizzle/**"], "maxFileLines": 150},
    {"role": "REMOTE", "paths": ["src/apple-music/**", "src/browser/server-api/**"], "maxFileLines": 150},
    {"role": "BUILD", "paths": ["scripts/**", "*.config.ts"], "maxFileLines": 250},
    {"role": "TEST", "paths": ["tests/**"]}
  ],
  "mayImport": {
    "VIEW": [
      "VIEW",
      "CONTROLLER",
      "STATE",
      "PURE-CORE",
      "PURE",
      "DATA"
    ],
    "CONTROLLER": [
      "CONTROLLER",
      "STATE",
      "PURE-CORE",
      "PURE",
      "DATA",
      "PLATFORM-PURE",
      "PLATFORM-AMBIENT",
      "MODEL",
      "REMOTE"
    ],
    "STATE": [
      "STATE",
      "PURE-CORE",
      "PURE",
      "DATA",
      "PLATFORM-PURE"
    ],
    "PURE-CORE": [
      "PURE-CORE",
      "DATA",
      "PLATFORM-PURE"
    ],
    "PURE": [
      "PURE",
      "PURE-CORE",
      "DATA",
      "PLATFORM-PURE"
    ],
    "PLATFORM-PURE": [
      "DATA"
    ],
    "PLATFORM-AMBIENT": [
      "PLATFORM-PURE",
      "DATA"
    ],
    "MODEL": [
      "MODEL",
      "PURE-CORE",
      "PURE",
      "DATA",
      "PLATFORM-PURE"
    ],
    "REMOTE": [
      "REMOTE",
      "PURE-CORE",
      "PURE",
      "DATA",
      "PLATFORM-PURE"
    ]
  },
  "boundaries": [
    {
      "from": "src/browser/**",
      "mayNotImport": [
        "src/server/**",
        "src/db/**",
        "src/platform/**",
        "src/apple-music/**"
      ]
    },
    {
      "from": "src/server/**",
      "mayNotImport": [
        "src/browser/**"
      ]
    }
  ],
  "packageRestrictions": [
    {
      "packages": [
        "pg",
        "drizzle-orm"
      ],
      "allowedIn": [
        "src/db/**"
      ]
    },
    {
      "packages": [
        "better-auth"
      ],
      "allowedIn": [
        "src/server/auth/**"
      ]
    },
    {
      "packages": [
        "fastify",
        "@fastify/*"
      ],
      "allowedIn": [
        "src/server/**"
      ]
    },
    {
      "packages": [
        "preact"
      ],
      "allowedIn": [
        "src/browser/views/**",
        "src/browser/controllers/**",
        "src/browser/main.tsx"
      ]
    },
    {
      "packages": [
        "typebox"
      ],
      "allowedIn": [
        "src/contracts/**",
        "src/server/**"
      ]
    },
    {
      "packages": [
        "argon2",
        "jose",
        "node:crypto"
      ],
      "allowedIn": [
        "src/platform/**"
      ]
    }
  ],
  "globalRestrictions": [
    {
      "global": "fetch",
      "allowedIn": [
        "src/apple-music/**",
        "src/browser/server-api/**"
      ]
    },
    {
      "global": "process.env",
      "allowedIn": [
        "src/server/config/**"
      ]
    }
  ],
  "ambient": {
    "forbiddenInRoles": [
      "VIEW",
      "STATE",
      "PURE-CORE",
      "PURE",
      "PLATFORM-PURE"
    ],
    "identifiers": [
      "Date.now",
      "Math.random",
      "performance.now",
      "crypto.randomUUID",
      "setTimeout",
      "setInterval",
      "document",
      "window",
      "localStorage",
      "sessionStorage",
      "navigator",
      "process"
    ]
  },
  "localization": {
    "languages": "data/locales/languages.json",
    "domains": [
      "interface",
      "display-names"
    ],
    "generatedInterfacePrefixes": [
      "errors."
    ]
  },
  "dataSchemas": [
    {
      "files": "data/taxonomies/*.json",
      "schema": "data/schemas/taxonomy.schema.json"
    },
    {
      "files": "data/locales/*/*.json",
      "schema": "data/schemas/messages.schema.json"
    },
    {
      "files": "data/locales/languages.json",
      "schema": "data/schemas/languages.schema.json"
    },
    {
      "files": "data/security/content-security-policy.json",
      "schema": "data/schemas/content-security-policy.schema.json"
    }
  ]
}
